{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/nav-tabs.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/members-transfers",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/buffer",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/threads",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/buffer-manual",
      "schedule": "35 * * * *"
    }
  ]
}
