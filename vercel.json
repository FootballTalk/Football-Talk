{
  "functions": {
    "api/womens.js": {
      "maxDuration": 30
    },
    "api/weekly-newsletter.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/nav-tabs.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/facebook-reels-auto",
      "schedule": "*/25 * * * *"
    },
    {
      "path": "/api/buffer",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/threads",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/buffer-manual",
      "schedule": "0,40 */2 * * *"
    },
    {
      "path": "/api/buffer-manual",
      "schedule": "20 1-23/2 * * *"
    },
    {
      "path": "/api/weekend-tv-social",
      "schedule": "*/10 17,18,19 * * 4"
    },
    {
      "path": "/api/ref-watch",
      "schedule": "30 12 * * 1"
    },
    {
      "path": "/api/weekly-newsletter",
      "schedule": "0 8,9 * * 5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/instagram-story/:story",
      "destination": "/api/instagram-story-image"
    }
  ],
  "redirects": [
    {
      "source": "/22law",
      "destination": "https://www.22law.co.uk/?utm_source=footballtalk&utm_medium=social&utm_campaign=22law_featured_partner",
      "permanent": false
    },
    {
      "source": "/members.html",
      "destination": "/more.html",
      "permanent": true
    },
    {
      "source": "/account.html",
      "destination": "/more.html",
      "permanent": true
    }
  ]
}